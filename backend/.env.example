PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/tiktak

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_jwt_secret_change_this_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_change_this_too
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET_VIDEOS=tiktak-videos
S3_BUCKET_THUMBNAILS=tiktak-thumbnails
S3_BUCKET_AUDIO=tiktak-audio

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# Internal service key
INTERNAL_KEY=internal_secret_key

# AI Service (Python FastAPI)
AI_SERVICE_URL=http://localhost:8002
