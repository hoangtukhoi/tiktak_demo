# ---- Server ----
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
# Đặt false nếu chạy worker bằng tiến trình riêng (npm run worker)
RUN_WORKERS_IN_API=true

# ---- MongoDB ----
MONGODB_URI=mongodb://localhost:27017/tiktak
MONGODB_DB_NAME=tiktak

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- JWT ----
JWT_SECRET=doi_gia_tri_nay_truoc_khi_deploy
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=doi_gia_tri_nay_truoc_khi_deploy_2
JWT_REFRESH_EXPIRES_IN=7d

# ---- Google OAuth (để trống nếu chưa dùng) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ---- S3 / MinIO ----
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_FORCE_PATH_STYLE=true
S3_BUCKET_VIDEOS=tiktak-videos
S3_BUCKET_THUMBNAILS=tiktak-thumbnails
S3_BUCKET_AUDIO=tiktak-audio

# ---- Frontend (CORS) ----
FRONTEND_URL=http://localhost:3000

# ---- AI service (Python FastAPI) ----
AI_SERVICE_URL=http://localhost:8002
AI_SERVICE_TIMEOUT_MS=600000
INTERNAL_KEY=doi_gia_tri_nay

# ---- FFmpeg (để trống nếu đã có trong PATH) ----
FFMPEG_PATH=
FFPROBE_PATH=
TMP_DIR=
