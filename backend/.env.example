# ─────────────────────────────────────────────────────
# TikTak Backend — Environment Variables
# Copy file này thành .env rồi điền giá trị thực
#   cp .env.example .env
# ─────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ─────────────────────────────────────────
# Docker: mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net
MONGODB_URI=mongodb://localhost:27017

# ── Redis ────────────────────────────────────────────
# Docker: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ── JWT ─────────────────────────────────────────────
# Dùng lệnh sau để tạo secret ngẫu nhiên:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string_at_least_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_to_another_long_random_string_64_chars
JWT_REFRESH_EXPIRES_IN=7d

# ── Đăng nhập Google (bỏ trống nếu không dùng → nút Google tự ẩn) ──────────
# Tạo ở Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
#   Authorized JavaScript origins: http://localhost:3000
#   Authorized redirect URIs:      http://localhost:3000/api/auth/google/callback
# Callback đi qua frontend (Vite proxy /api) để cookie chống giả mạo cùng domain với trang web.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Địa chỉ công khai của web (dùng cho link chia sẻ /s/:id). Bỏ trống khi chạy local.
PUBLIC_URL=

# ── MinIO / AWS S3 ───────────────────────────────────
# Docker MinIO local:
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET_VIDEOS=tiktak-videos
S3_BUCKET_THUMBNAILS=tiktak-thumbnails
S3_BUCKET_AUDIO=tiktak-audio

# ── CORS ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Internal / AI Service ────────────────────────────
INTERNAL_KEY=internal_secret_key
AI_SERVICE_URL=http://localhost:8002
# true = dùng dữ liệu giả cho STT/dịch/TTS (demo khi chưa chạy AI service)
AI_MOCK=false
# Host MinIO mà AI service nhìn thấy. AI service chạy bằng docker compose → http://minio:9000
# AI service chạy trực tiếp trên máy → bỏ trống
AI_MEDIA_BASE_URL=http://minio:9000

# ── Admin seed (dùng khi chạy npm run seed) ──────────
ADMIN_EMAIL=admin@tiktak.com
ADMIN_PASSWORD=Admin@123456
ADMIN_USERNAME=admin

# ── Hiệu năng / xử lý video ─────────────────────────
# Đường dẫn ffmpeg nếu không có trong PATH (Windows VD: C:\ffmpeg\bin\ffmpeg.exe)
# FFMPEG_PATH=
# FFPROBE_PATH=
TRANSCODE_MAX_SIDE=720
TRANSCODE_CONCURRENCY=1
FEED_CACHE_TTL=60
# API_RATE_LIMIT=5000

# Số ngày giữa 2 lần đổi username (0 = không giới hạn, tiện khi test)
USERNAME_CHANGE_DAYS=30

# ── Kiểm duyệt bình luận ─────────────────────────────
# auto = 3 mức (mặc định): điểm < REVIEW → hiện ngay; REVIEW ≤ điểm < REJECT → chờ admin duyệt; điểm ≥ REJECT → ẩn luôn
# semi = không tự ẩn: điểm ≥ REVIEW đều chờ admin duyệt
# off  = tắt (mọi bình luận hiện ngay)
# Điểm do model trong ai-service chấm (POST /moderate/comments); AI service tắt → dùng bộ lọc từ khoá
COMMENT_MODERATION_MODE=auto
COMMENT_REVIEW_THRESHOLD=0.5
COMMENT_REJECT_THRESHOLD=0.85
COMMENT_MODERATION_TIMEOUT_MS=2500

# Số báo cáo chưa xử lý để video tự bị gắn cờ chờ admin xem
REPORT_FLAG_THRESHOLD=3

# ── Giới hạn tần suất theo tài khoản (bỏ trống = mặc định) ──────────────────
# COMMENT_RATE_LIMIT=12     # bình luận / phút
# FOLLOW_RATE_LIMIT=30      # theo dõi, bỏ theo dõi, chặn / phút
# REACTION_RATE_LIMIT=90    # thích, lưu, đăng lại, ghim / phút
# REPORT_RATE_LIMIT=10      # báo cáo / 10 phút
