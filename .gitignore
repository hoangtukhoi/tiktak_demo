# Dependencies
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# Environment files — KHÔNG bao giờ commit
.env
.env.local
.env.development
.env.production
.env.*.local

# Build outputs
dist/
build/
*.js.map

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# Temp / uploads
tmp/
temp/
uploads/

# Python cache
*.egg-info/
.pytest_cache/

# Docker volumes (nếu mount local)
postgres_data/
redis_data/
minio_data/

# Keys / secrets
*.pem
*.key
*.p12

.graphify-out/
# Model kiểm duyệt bình luận (file lớn, không commit) — giữ lại README hướng dẫn
ai-service/moderation_model/*
!ai-service/moderation_model/README.md
# File nén model tải về (vài trăm MB, GitHub chặn file > 100 MB)
ai-service/*.zip

# Báo cáo độ phủ test
coverage/

# Tài khoản bot test (npm run bot)
.bot-accounts.json

# Bản sao lưu trước khi gộp giao diện (không đưa lên git)
_backup/
