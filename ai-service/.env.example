AI_HOST=0.0.0.0
AI_PORT=8002
# Phải trùng INTERNAL_KEY trong backend/.env
AI_INTERNAL_KEY=internal_secret_key

# tiny | base | small | medium | large-v3
AI_WHISPER_MODEL=small
# auto | cpu | cuda
AI_WHISPER_DEVICE=auto
AI_WHISPER_COMPUTE_TYPE=int8

AI_TRANSLATION_MODEL=facebook/nllb-200-distilled-600M

# edge | none
AI_TTS_ENGINE=edge
# Docker: /models — chạy trực tiếp trên Windows: ./models
AI_MODEL_CACHE_DIR=/models
AI_DOWNLOAD_TIMEOUT=120

# ── Kiểm duyệt bình luận ─────────────────────────────
# Bỏ trống = tự tìm model trong ai-service/moderation_model/ (chép model vào đó là đủ).
# Hoặc: thư mục HuggingFace (có config.json), file .pkl/.joblib, hay tên repo trên HuggingFace Hub (ten-ban/ten-model).

AI_MODERATION_MODEL_PATH=
# auto | hf | sklearn
AI_MODERATION_MODEL_TYPE=auto
# Các nhãn coi là "sạch", cách nhau dấu phẩy
AI_MODERATION_CLEAN_LABELS=clean,normal,non-toxic,ok,label_0,0
# Nếu model chỉ lưu nhãn dạng số, đặt tên theo thứ tự lớp (VD: clean,offensive,hate)
AI_MODERATION_LABEL_NAMES=
AI_MODERATION_MAX_LENGTH=256
# true nếu lúc train bạn đã chuyển văn bản về chữ thường
AI_MODERATION_LOWERCASE=false
# Tách từ trước khi chấm: auto (theo config.json của model) | pyvi | none
AI_MODERATION_WORD_SEGMENTER=auto
